# Forecast/truth zarrs and the metrics parquet (1.2 GB and growing).
data/

# Python
__pycache__/
*.pyc

# Local env hack backup (torch-harmonics ABI shim), not part of the project.
.th_shim_backup/

# Generated site artifacts. docs/index.html IS committed — it is the published
# page, with metrics inlined. As of E1 it also links docs/lib/css/site.css
# (shared with compare.html and map.html), so it is no longer standalone: that
# stylesheet must be committed alongside it or the page renders unstyled.
# The plain charts page and its PNGs are regenerated on every publish, so
# committing them would add ~1.3 MB of churn to git history per run.
docs/assets/
docs/charts.html

# Authored front-end code (docs/lib/) and the payloads the explorer pages fetch
# (docs/data/) are both tracked — GitHub Pages can only serve committed files.
# Listed explicitly because docs/assets/ above ignores its sibling wholesale and
# the asymmetry is easy to misread.
!docs/lib/
!docs/data/
